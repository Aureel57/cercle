rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Site v1 (inchangé) ──
    match /users/{userId} {
      allow read, write: if true;
    }
    match /items/{itemId} {
      allow read, write: if true;
    }

    // ── Annonces partagées v2 ──
    match /v2_listings/{doc} {
      allow read, write: if true;
    }

    // ── Avis partagés v2 (actif tout de suite) ──
    match /v2_reviews/{doc} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // ── Réservations v2 (pour la prochaine étape) ──
    match /v2_reservations/{doc} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.renterUid
            || request.auth.uid == resource.data.ownerUid);
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.renterUid;
      allow update, delete: if request.auth != null
        && (request.auth.uid == resource.data.renterUid
            || request.auth.uid == resource.data.ownerUid);
    }

    // ── Messagerie v2 (pour la prochaine étape) ──
    match /v2_conversations/{conv} {
      allow read, update: if request.auth != null
        && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.members;
      match /messages/{msg} {
        allow read, create: if request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/v2_conversations/$(conv)).data.members;
      }
    }

  }
}
